# =================================================================
# Enterprise Workflow Engine - Production Environment Configuration
# =================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# IMPORTANT: Generate a secure random string for JWT_SECRET and
# set a strong database password before deploying to production!
# =================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!
POSTGRES_DB=workflow_db
DB_HOST=db
DB_PORT=5432

# Backend API Configuration
BACKEND_PORT=3010
NODE_ENV=production
JWT_SECRET=b7e58a2d1f934c6e804f9b8c3d2e1a0f5e7a9c8b6d4e2f0a1c3b5d7e9f1a2c4

# Frontend Configuration
FRONTEND_PORT=80
# Optional: Set this only if frontend is served on a different domain from backend API
# REACT_APP_API_URL=http://your-server-ip:3000

# Docker Restart Policy (always, unless-stopped)
RESTART_POLICY=unless-stopped

# Active Directory / LDAP Host Resolution (Optional)
# If your Docker host cannot resolve your corporate AD domain (.local / .corp) via DNS,
# specify the AD hostname and server IP below to automatically map it inside the container:
# Format: hostname.domain.local:IP_ADDRESS
# Example: AD_HOST_ENTRY=dc01.company.local:192.168.1.10
# (Alternatively, you can simply type direct IP like ldap://192.168.1.10:389 in the Web UI)
# AD_HOST_ENTRY=ad.company.local:192.168.1.10

